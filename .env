# FastAPI / Knot-Labs defaults

# Allow the API to serve uploaded files for preview
KNOT_SERVE_UPLOADS=1

# CORS: list of allowed origins (comma-separated, no spaces needed but allowed)
# - Keep localhost to use the API-served UI and local tools
# - Replace <your-user> with your GitHub username to allow the GitHub Pages UI
KNOT_CORS_ORIGINS=http://localhost:8000, http://127.0.0.1:8000, https://stiven-gjekaj.github.io

# Optional Redis configuration (leave blank or set your own)
# If your Redis requires TLS, use rediss://; otherwise use redis://
# REDIS_URL=
# KNOT_RATE_BACKEND=redis

# Optional MongoDB configuration
# Example: mongodb+srv://user:pass@cluster-url/?retryWrites=true&w=majority
MONGO_URI=
MONGO_DB=knot

# Optional: when using TLS and encountering certificate issues, you can relax verification (not recommended for production)
# REDIS_SSL_CERT_REQS=none

# Cache options (defaults are fine)
# KNOT_CACHE_ENABLED=1
# KNOT_CACHE_TTL=60
# KNOT_CACHE_PREFIX=knot:cache

# API key (optional). If set, protected routes require X-API-Key.
# KNOT_API_KEY=secret

# Tip: start with
#   uvicorn --env-file .env api.main:app --reload

# Veil defaults (fusion pipeline)
VEIL_CACHED_ONLY=true # avoid NPZ builds on the host
VEIL_FAST_BOOT=true # Skip embedding builds
# Frames: lower = faster; 4 is a good CPU default
KNOT_VEIL_FRAMES=4
# Enable Whisper with 0.3 weight and YAMNet with 0.2 weight by default
KNOT_VEIL_USE_WHISPER=true
KNOT_W_AUDIO=0.2
# Increase child-process timeout for veil.run (seconds)
KNOT_VEIL_TIMEOUT_SEC=600