# FastAPI / Knot-Labs defaults

# Allow the API to serve uploaded files for preview
KNOT_SERVE_UPLOADS=1

# CORS: list of allowed origins (comma-separated, no spaces needed but allowed)
# - Keep localhost to use the API-served UI and local tools
# - Replace <your-user> with your GitHub username to allow the GitHub Pages UI
KNOT_CORS_ORIGINS=http://localhost:8000, http://127.0.0.1:8000, https://stiven-gjekaj.github.io

# Optional Redis configuration (set to use Redis Cloud)
# If your Redis requires TLS, use rediss://
REDIS_URL=rediss://default:5Cfr8fRKaUaFRXNsYTfuXZ2UJwgNUxVU@redis-16217.c135.eu-central-1-1.ec2.redns.redis-cloud.com:16217/0
KNOT_RATE_BACKEND=redis

# Cache options (defaults are fine)
# KNOT_CACHE_ENABLED=1
# KNOT_CACHE_TTL=60
# KNOT_CACHE_PREFIX=knot:cache

# API key (optional). If set, protected routes require X-API-Key.
# KNOT_API_KEY=secret

# Tip: start with
#   uvicorn --env-file .env api.main:app --reload
